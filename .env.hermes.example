# Copy to .env.hermes and fill in. NEVER commit .env.hermes (it's gitignored).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx        # required — pays for each round's edit
GITHUB_TOKEN=ghp_xxxxxxxx                # required — clone + push (needs repo write). Fine-grained PAT scoped to this repo.

# Windows Docker Desktop path to the live card DB directory (contains mtg-deck-builder.db):
DB_HOST_DIR=C:/Users/QuLeR/AppData/Roaming/the-black-grimoire/data

REPO_SLUG=Karolis332/MTG-deck-builder    # repo the bot clones + pushes to
IMPROVE_BRANCH=hermes-auto               # branch it pushes (never main)
BASE_BRANCH=main
ROUNDS_PER_BATCH=5                        # rounds per loop batch before a push/backoff check
# DB_REFRESH=1                            # uncomment once to re-copy the card DB on next start
