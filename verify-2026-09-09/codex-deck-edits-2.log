from pathlib import Path
from collections import Counter, defaultdict
from html.parser import HTMLParser
import json, os, sqlite3, re
BASE=Path.cwd()/'decks/paper'
NAMES={'meren':'Meren of Clan Nel Toth','imotekh':'Imotekh the Stormlord','tazri':'Tazri, Beacon of Unity'}
FILES={'meren':'meren-of-clan-nel-toth','imotekh':'imotekh-the-stormlord','tazri':'tazri-beacon-of-unity'}
def front(n): return n.split(' // ')[0]
def parse(p):
    c=Counter()
    for line in p.read_text(encoding='utf-8-sig').splitlines():
        m=re.match(r'"'^('"\\d+)\\s+(.+)"'$'"',line.strip())
        if m: c[front(m[2])]+=int(m[1])
    return c
decks={k:parse(BASE/'decks'/f'{v}.txt') for k,v in FILES.items()}
models={k:parse(BASE/'proposals'/f'{k}-model.txt') for k in NAMES}
pool=parse(BASE/'open-cards.txt')
stats=json.loads((Path.cwd()/'data/corpus-stats.json').read_text(encoding='utf-8'))
db=Path(os.environ['APPDATA'])/'the-black-grimoire/data/mtg-deck-builder.db'
con=sqlite3.connect(db.as_uri()+'?mode=ro',uri=True)
con.row_factory=sqlite3.Row
cards={}
for row in con.execute('select name,mana_cost,cmc,type_line,oracle_text,color_identity,edhrec_rank,price_usd,produced_mana,layout from cards'):
    r=dict(row)
    cards[r['name']]=r
    cards.setdefault(front(r['name']),r)
def stat(k,n):
    s=stats[NAMES[k]].get(n)
    if s is None and n in cards: s=stats[NAMES[k]].get(cards[n]['name'])
    return f'{s[0]*100:.1f}%/{s[1]:+.2f}' if s else 'n/a'
def show(n,k=None,oracle=False):
    r=cards.get(n,{})
    msg=f\"{n} | {r.get('mana_cost','?')} MV={r.get('cmc','?')} | {r.get('type_line','?')}\"
    if k: msg+=f' | {stat(k,n)}'
    if oracle: msg+=' | '+r.get('oracle_text','?').replace('\\n',' / ')
    print(msg)

for n in ['Stump Stomp','Sygg, Wanderwine Wisdom','Revitalizing Repast','Boggart Trawler','Tangled Florahedron','Egon, God of Death','Festering Thicket','Turbulent Fen','Vernal Fen','Viridescent Bog','Realm of Koh','Muraganda Raceway','Conduit Pylons']:
    show(n,oracle=True)
print('\\nMEREN REVIEW')
for n in ['Baba Lysaga, Night Witch',\"Chief Warg's Company\",'Dina, Essence Brewer','Gorma, the Gullet','Grave Researcher','Jenova, Ancient Calamity','High-Society Hunter','Cauldron of Souls','Mirkwood Bats','The Gitrog, Ravenous Ride','Vraan, Executioner Thane','Creakwood Liege','Mycoloth','Smothering Abomination','Corpse Augur','Mazirek, Kraul Death Priest']:
