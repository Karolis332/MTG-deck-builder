from pathlib import Path
from collections import Counter, defaultdict
from html.parser import HTMLParser
import json, os, sqlite3, re
BASE=Path.cwd()/'decks/paper'
NAMES={'meren':'Meren of Clan Nel Toth','imotekh':'Imotekh the Stormlord','tazri':'Tazri, Beacon of Unity'}
FILES={'meren':'meren-of-clan-nel-toth','imotekh':'imotekh-the-stormlord','tazri':'tazri-beacon-of-unity'}
def front(n): return n.split(' // ')[0]
def parse(p):
    c=Counter()
    for line in p.read_text(encoding='utf-8-sig').splitlines():
        m=re.match(r'"'^('"\\d+)\\s+(.+)"'$'"',line.strip())
        if m: c[front(m[2])]+=int(m[1])
    return c
decks={k:parse(BASE/'decks'/f'{v}.txt') for k,v in FILES.items()}
models={k:parse(BASE/'proposals'/f'{k}-model.txt') for k in NAMES}
pool=parse(BASE/'open-cards.txt')
stats=json.loads((Path.cwd()/'data/corpus-stats.json').read_text(encoding='utf-8'))
db=Path(os.environ['APPDATA'])/'the-black-grimoire/data/mtg-deck-builder.db'
con=sqlite3.connect(db.as_uri()+'?mode=ro',uri=True)
con.row_factory=sqlite3.Row
cards={}
for row in con.execute('select name,mana_cost,cmc,type_line,oracle_text,color_identity,edhrec_rank,price_usd,produced_mana,layout from cards'):
    r=dict(row)
    cards[r['name']]=r
    cards.setdefault(front(r['name']),r)
def stat(k,n):
    s=stats[NAMES[k]].get(n)
    if s is None and n in cards: s=stats[NAMES[k]].get(cards[n]['name'])
    return f'{s[0]*100:.1f}%/{s[1]:+.2f}' if s else 'n/a'
def show(n,k=None,oracle=False):
    r=cards.get(n,{})
    msg=f\"{n} | {r.get('mana_cost','?')} MV={r.get('cmc','?')} | {r.get('type_line','?')}\"
    if k: msg+=f' | {stat(k,n)}'
    if oracle: msg+=' | '+r.get('oracle_text','?').replace('\\n',' / ')
    print(msg)

print('IMOTEKH KEEP/CUT CANDIDATES')
for n in ['Barkform Harvester','Umbral Collar Zealot','Syr Konrad, the Grim','Planetarium of Wan Shi Tong','Diabolic Tutor','Lembas','Black Sun\\'s Twilight','Altar of Bhaal','The Soul Stone','Traxos, Scourge of Kroog','Metalwork Colossus','Trazyn the Infinite','Phyrexian Scriptures','Emergency Weld','Culling the Weak']:
    show(n,'imotekh',True)
print('IMOTEKH ADD CANDIDATES')
for n in ['Plasmancer','Ghost Ark','Lychguard','Triarch Stalker','Sautekh Immortal','Skorpekh Destroyer','Phyrexian Arena','Crypt Ghast','Sivriss, Nightmare Speaker','The Darkness Crystal','Lightning Greaves','Imp\\'s Mischief','Insatiable Avarice','Bitter Triumph','Lively Dirge','Sign in Blood','Feed the Swarm']:
    show(n,'imotekh',True)
print('LOW-COST POOL ARTIFACTS/BLACK PERMANENTS WITH GRAVEYARD OR SACRIFICE TEXT, NOT ALREADY IN IMOTEKH')
for n in pool:
    r=cards[n]
    if n in decks['imotekh'] or r['cmc']>4 or not set(json.loads(r['color_identity']))<=set('B'): continue
    if any(w in r['oracle_text'].lower() for w in ['graveyard','sacrifice']) and ('Artifact' in r['type_line'] or 'Creature' in r['type_line'] or 'Enchantment' in r['type_line']): show(n,'imotekh')
print('LANDS IN POOL')
for n in pool:
    if 'Land' in cards[n]['type_line']: print(n,':',cards[n]['oracle_text'].replace('\\n',' / '))

