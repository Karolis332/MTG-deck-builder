print('\\nMEREN CANDIDATES')
for n in ['Accursed Marauder','Haywire Mite','Carrion Feeder','Ravenous Chupacabra','Mikaeus, the Unhallowed','Junji, the Midnight Sky','Midnight Reaper','Woe Strider','Insidious Roots','Pawn of Ulamog','Grist, Voracious Larva','Lively Dirge','Honest Rutstein','Forsaken Miner','Jarad, Golgari Lich Lord']:
