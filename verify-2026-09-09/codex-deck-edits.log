"C:\\Users\\QuLeR\\AppData\\Local\\Microsoft\\WindowsApps\\pwsh.exe" -NoProfile -Command "@'
from pathlib import Path
from collections import Counter
import json,sqlite3,os
root=Path('decks/paper')
def read(p):
 a=Counter()
 for l in p.read_text(encoding='utf-8-sig').splitlines():
  if l.strip():
   q,n=l.split(' ',1);a[n.split(' // ')[0]]+=int(q)
 return dict(a)
slugs={'meren':'meren-of-clan-nel-toth','imotekh':'imotekh-the-stormlord','tazri':'tazri-beacon-of-unity'}
original={k:read(root/'decks'/f'{v}.txt') for k,v in slugs.items()}
model={k:read(root/'proposals'/f'{k}-model.txt') for k in slugs}
pool=read(root/'open-cards.txt')
names=set(pool).union(*(set(v) for v in original.values()),*(set(v) for v in model.values()))
c=sqlite3.connect((Path(os.environ['APPDATA'])/'the-black-grimoire/data/mtg-deck-builder.db').as_uri()+'?mode=ro',uri=True)
c.row_factory=sqlite3.Row
cards={}
def score(d): return (d['layout']"'!='"'art_series',bool(d['oracle_text']),d['type_line']"'!='"'Card // Card',' // ' in d['name'])
for r in c.execute('select name,mana_cost,cmc,type_line,oracle_text,color_identity,legalities,layout from cards'):
 d=dict(r);n=d['name'].split(' // ')[0]
 if n not in names: continue
