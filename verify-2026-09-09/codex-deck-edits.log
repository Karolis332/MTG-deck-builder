from html.parser import HTMLParser
from pathlib import Path
class Plan(HTMLParser):
 def __init__(self):
  super().__init__();self.why=False
 def handle_starttag(self,tag,attrs):
  a=dict(attrs)
  if tag=='section': print('\\nDECK',a.get('id'))
  if tag=='label' and a.get('class')=='swap': print('\\n'+a.get('data-key',''))
  if tag=='p' and a.get('class')=='why': self.why=True
 def handle_data(self,data):
  if self.why: print(data.strip())
 def handle_endtag(self,tag):
  if tag=='p': self.why=False
Plan().feed(Path('decks/paper/edit-plan.html').read_text(encoding='utf-8'))
