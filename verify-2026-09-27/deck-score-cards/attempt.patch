--- a/scripts/deck-score-catalog-generate.ts
+++ b/scripts/deck-score-catalog-generate.ts
@@ -49,9 +49,21 @@ function universe(): GeneratableCard[] {
     for (const c of input.commander) add(c);
   }
   for (const card of corpusCards()) add(card);
+  for (const card of extraCards()) add(card);
   return [...byName.values()].sort((a, b) => a.name.localeCompare(b.name));
 }
 
+/** Sets newer than the corpora (`deck-score-universe-extra.json`, e.g. Reality
+ * Fracture): typed so decks playing them are not scored as untyped. A name the
+ * card DB lacks fails loudly — refresh the DB first. */
+function extraCards(): GeneratableCard[] {
+  const { names } = JSON.parse(fs.readFileSync(path.join(ROOT, 'scripts', 'deck-score-universe-extra.json'), 'utf-8')) as { names: string[] };
+  const byName = cardsByName();
+  const missing = names.filter((n) => !byName.has(n.toLowerCase()));
+  if (missing.length) throw new Error(`extra universe: ${missing.length} name(s) not in the card DB: ${missing.slice(0, 5).join(', ')}`);
+  return names.map((n) => byName.get(n.toLowerCase())!);
+}
