+import Image from 'next/image';
+import Link from 'next/link';
+import { ArrowRight, Sparkles } from 'lucide-react';
+import { buttonVariants } from '@/components/ui/button';
+import { siteFacts } from '@/lib/site-facts';
+import { cn } from '@/lib/utils';
+
+export function Hero() {
+  return (
+    <section aria-labelledby="hero-title" className="landing-hero">
+      <div className="landing-shell grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[0.95fr_1.15fr] lg:gap-12 lg:py-20">
+        <div>
+          <p className="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/5 px-3 py-1.5 text-sm text-primary">
+            <Sparkles aria-hidden="true" className="size-3.5" />
+            Free · No account required
+          </p>
+          <h1 id="hero-title" className="text-[1.65rem] font-semibold leading-[1.45] tracking-normal sm:text-[2rem] lg:text-[2.05rem]">
+            The Black Grimoire is a <span className="text-primary">free Commander and Brawl deck builder</span>{' '}
+            that ranks cards using patterns from {siteFacts.deckCountPretty} real decklists.
+          </h1>
+          <p className="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
+            Get a complete deck built around your commander, with a stated reason for
+            every card and a check against Wizards&apos; official Commander Bracket rules.
+          </p>
+          <div className="mt-7 flex flex-col gap-3 sm:flex-row">
+            <Link href="/builder" className={cn(buttonVariants({ size: 'lg' }), 'gap-2')}>
+              Build a deck free <ArrowRight aria-hidden="true" className="size-4" />
+            </Link>
+            <Link href="/commanders" className={buttonVariants({ variant: 'outline', size: 'lg' })}>
+              Browse commanders
+            </Link>
+          </div>
+          <p className="mt-4 text-sm text-muted-foreground">
+            Works in your browser · Builds take {siteFacts.buildTimeLow}–{siteFacts.buildTimeHigh}s
+          </p>
+        </div>
+        <figure className="landing-product-window min-w-0">
+          <div className="flex items-center gap-3 border-b border-primary/20 px-4 py-3 text-xs text-muted-foreground">
+            <span aria-hidden="true" className="flex gap-1.5">
+              <span className="size-1.5 rounded-full bg-primary/70" />
+              <span className="size-1.5 rounded-full bg-primary/35" />
+              <span className="size-1.5 rounded-full bg-primary/20" />
+            </span>
+            <span className="font-mono text-[10px] tracking-wider">THE BLACK GRIMOIRE / BUILDER</span>
+          </div>
+          <Image
+            src="/screenshots/builder-result.png"
+            width={1513}
+            height={1150}
+            priority
+            sizes="(max-width: 1023px) calc(100vw - 48px), (max-width: 1279px) 52vw, 650px"
+            alt="A Krenko, Mob Boss deck built by The Black Grimoire: 100 cards, 38 lands, mana curve and deck intelligence"
+            className="block h-auto w-full"
+          />
+          <figcaption className="flex items-center justify-between gap-3 border-t border-primary/15 px-4 py-3 text-sm">
+            <span>Krenko, Mob Boss <span className="text-muted-foreground">/ Commander</span></span>
+            <span className="text-primary">Builder result</span>
+          </figcaption>
+        </figure>
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/landing/see-it-work.tsx b/src/components/landing/see-it-work.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..704ddce74ec856945309d1b776da3152e465fa8d
