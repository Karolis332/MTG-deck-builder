+            width={1513}
+            height={1150}
+            priority
+            sizes="(max-width: 1023px) calc(100vw - 48px), (max-width: 1279px) 52vw, 650px"
+            alt="A Krenko, Mob Boss deck built by The Black Grimoire: 100 cards, 38 lands, mana curve and deck intelligence"
