// Renders one <script type="application/ld+json"> tag per call. Pages compose plain
// objects (WebSite, Organization, FAQPage, BreadcrumbList, ...) and pass them in —
// no schema-builder abstraction needed for a handful of static blocks.
export function JsonLd({ data }: { data: Record<string, unknown> }) {
  return (
    <script
      type="application/ld+json"
      dangerouslySetInnerHTML={{ __html: JSON.stringify(data) }}
    />
  );
}

export function breadcrumbJsonLd(items: { name: string; url: string }[]) {
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  };
}
import { JsonLd } from '@/components/json-ld';
import { siteFacts } from '@/lib/site-facts';

// One WebPage node per public page — freshness dates + WebSite/Person linkage, alongside
// whatever TechArticle/FAQPage/BreadcrumbList node that page already renders.
export function PageJsonLd({ name, path }: { name: string; path: string }) {
  return (
    <JsonLd
      data={{
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name,
        url: `${siteFacts.siteUrl}${path}`,
        datePublished: siteFacts.asOf,
        dateModified: siteFacts.asOf,
        isPartOf: { '@type': 'WebSite', url: siteFacts.siteUrl },
        author: { '@type': 'Person', name: siteFacts.author },
      }}
    />
  );
}
// Friends-phase kill switch: Clerk is unclaimed and sign-in over plain HTTP (VPS :8099,
// no domain/TLS yet) is broken, so accounts stay hidden until a real domain is live.
// NEXT_PUBLIC_* so the same check works in client components (site-header) and server
// components/route handlers (dashboard page, proxy middleware).
export function accountsEnabled(): boolean {
  return process.env.NEXT_PUBLIC_ACCOUNTS_ENABLED === '1';
}
'use client';

import { useUser } from '@clerk/nextjs';
import { accountsEnabled } from '@/lib/accounts-enabled';

// Loaded-and-signed-out shape, so callers need no null checks.
const SIGNED_OUT = { user: null, isLoaded: true, isSignedIn: false } as const;

// Drop-in for useUser() that is safe when the root layout renders no ClerkProvider
// (NEXT_PUBLIC_ACCOUNTS_ENABLED unset). Rules-of-hooks: accountsEnabled() reads a
// build-time NEXT_PUBLIC_* constant, so the branch is fixed for the whole build and the
// hook call order is identical across every render — hence the disable below.
export function useOptionalUser(): ReturnType<typeof useUser> {
  if (!accountsEnabled()) return SIGNED_OUT;
  // eslint-disable-next-line react-hooks/rules-of-hooks
  return useUser();
}
