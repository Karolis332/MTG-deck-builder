import type { Metadata } from 'next';
import { Cinzel, Crimson_Text, Geist_Mono } from 'next/font/google';
import { ClerkProvider } from '@clerk/nextjs';
import { SiteFooter } from '@/components/site-footer';
import { FeedbackWidget } from '@/components/feedback/feedback-widget';
import { accountsEnabled } from '@/lib/accounts-enabled';
import { siteFacts } from '@/lib/site-facts';
import './globals.css';

const description =
  'The Black Grimoire is a free Magic: The Gathering deck builder for Commander and Brawl, ranked by patterns from nearly 4 million real decklists. No accounts, no paywall.';

// Cinzel for headings, Crimson Text for body — the same pairing as the desktop
// app (src/app/layout.tsx there), exposed as --font-heading / --font-body via
// the @theme block in globals.css. Geist Mono is kept for font-mono (mana
// costs, card counts).
const cinzel = Cinzel({
  variable: '--font-cinzel',
  subsets: ['latin'],
  weight: ['400', '500', '600', '700'],
  display: 'swap',
});

const crimsonText = Crimson_Text({
  variable: '--font-crimson',
  subsets: ['latin'],
  weight: ['400', '600', '700'],
  style: ['normal', 'italic'],
  display: 'swap',
});

const geistMono = Geist_Mono({
  variable: '--font-geist-mono',
  subsets: ['latin'],
});

export const metadata: Metadata = {
  metadataBase: new URL(process.env.NEXT_PUBLIC_APP_URL || siteFacts.siteUrl),
  title: {
    default: 'The Black Grimoire — Free Commander & Brawl Deck Builder',
    template: '%s — The Black Grimoire',
  },
  description,
  keywords: ['MTG', 'Magic: The Gathering', 'deck builder', 'commander', 'Arena', 'Brawl', 'EDH'],
  alternates: { canonical: '/' },
  authors: [{ name: siteFacts.author }],
  openGraph: {
    type: 'website',
    siteName: siteFacts.siteName,
    title: 'The Black Grimoire — Free Commander & Brawl Deck Builder',
    description,
    url: '/',
  },
  twitter: {
    card: 'summary_large_image',
    title: 'The Black Grimoire — Free Commander & Brawl Deck Builder',
    description,
  },
  other: {
    'article:published_time': siteFacts.asOf,
    'article:modified_time': siteFacts.asOf,
  },
};

export default function RootLayout({
  children,
}: Readonly<{
  children: React.ReactNode;
}>) {
  const page = (
    <html
      lang="en"
      className={`${cinzel.variable} ${crimsonText.variable} ${geistMono.variable} dark h-full antialiased`}
    >
      <body className="min-h-full flex flex-col bg-background text-foreground grimoire-page">
        {children}
        <SiteFooter />
        <FeedbackWidget />
      </body>
    </html>
  );

  // Accounts off (friends phase) = no ClerkProvider, so no Clerk JS, cookies or dev-key
  // warnings reach the browser. Client components use useOptionalUser() for the same reason.
  if (!accountsEnabled()) return page;

  return (
    <ClerkProvider
      appearance={{
        // No @clerk/themes dependency here — Clerk's `variables` only assume a light
        // UI unless every relevant color role is overridden, so this sets all of them
        // rather than just colorPrimary/colorBackground (which left headings and
        // secondary text nearly invisible against the dark card).
        variables: {
          colorPrimary: '#CBAC5D',
          colorBackground: 'hsl(24 20% 7%)',
          colorText: 'hsl(36 25% 86%)',
          colorTextSecondary: 'hsl(36 12% 48%)',
          colorTextOnPrimaryBackground: 'hsl(24 40% 8%)',
          colorInputBackground: 'hsl(24 16% 12%)',
          colorInputText: 'hsl(36 25% 86%)',
          colorNeutral: 'hsl(36 25% 86%)',
        },
        elements: {
          card: 'bg-[hsl(24_20%_7%)] border border-[hsl(30_16%_14%)]',
          headerTitle: 'text-[hsl(36_25%_86%)]',
          headerSubtitle: 'text-[hsl(36_12%_48%)]',
          formFieldLabel: 'text-[hsl(36_25%_86%)]',
          dividerText: 'text-[hsl(36_12%_48%)]',
          footerActionText: 'text-[hsl(36_12%_48%)]',
        },
      }}
    >
      {page}
    </ClerkProvider>
  );
}
