@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  body {
    @apply bg-background text-foreground;
  }
  html {
    @apply font-sans;
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    letter-spacing: 0.02em;
  }
}

@keyframes gold-shimmer {
  0% { background-position: 0% center; }
  100% { background-position: 200% center; }
}
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
@keyframes page-turn {
  0% { opacity: 0; transform: rotateY(-8deg) scale(0.98); }
  100% { opacity: 1; transform: rotateY(0deg) scale(1); }
}
@keyframes card-enter {
  0% { opacity: 0; transform: scale(0.95) translateY(8px); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes slide-up {
  0% { opacity: 0; transform: translateY(12px); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes fade-in {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
@keyframes pulse-glow {
  0%, 100% { box-shadow: 0 0 8px 2px rgba(203, 172, 93, 0.2); }
  50% { box-shadow: 0 0 16px 4px rgba(203, 172, 93, 0.4); }
}

/* ── Grimoire vignette overlay ────────────────────────────────────────── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  background: radial-gradient(ellipse at center, transparent 50%, rgba(0, 0, 0, 0.4) 100%);
}

/* ── Page texture background — subtle radial darkening, aged-parchment feel ── */
.grimoire-page {
  background:
    radial-gradient(ellipse at 20% 50%, hsl(30 20% 10% / 0.5) 0%, transparent 60%),
    radial-gradient(ellipse at 80% 30%, hsl(24 30% 8% / 0.3) 0%, transparent 50%),
    var(--background);
}

/* ── Custom scrollbar — aged leather ──────────────────────────────────── */
::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}
::-webkit-scrollbar-track {
  background: hsl(24 18% 5%);
  border-left: 1px solid hsl(30 16% 14%);
}
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, hsl(36 30% 22%), hsl(30 24% 16%));
  border-radius: 4px;
  border: 1px solid hsl(43 40% 28% / 0.3);
}
::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, hsl(43 40% 30%), hsl(36 30% 22%));
}

/* ── Focus & selection — gilded ───────────────────────────────────────── */
:focus-visible {
  outline: 2px solid hsl(43 60% 52% / 0.85);
  outline-offset: 2px;
  border-radius: 4px;
}
::selection {
  background: hsl(43 55% 40% / 0.45);
  color: hsl(40 30% 92%);
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ── Ornate double border — used on cards/panels ("book cover" frame) ──── */
.grimoire-border {
  position: relative;
  border: 1px solid hsl(43 40% 28% / 0.3);
}
.grimoire-border::before {
  content: '';
  position: absolute;
  inset: 3px;
  border: 1px solid hsl(43 40% 28% / 0.12);
  border-radius: inherit;
  pointer-events: none;
}

/* ── Gold accent line — horizontal divider ────────────────────────────── */
.grimoire-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, hsl(43 60% 40% / 0.4), transparent);
  margin: 1rem 0;
}

/* ── Ornate corner flourishes ─────────────────────────────────────────── */
.grimoire-corners {
  position: relative;
}
.grimoire-corners::before,
.grimoire-corners::after {
  content: '◈';
  position: absolute;
  color: hsl(43 60% 40% / 0.3);
  font-size: 14px;
  line-height: 1;
}
.grimoire-corners::before { top: -2px; left: 6px; }
.grimoire-corners::after { bottom: -2px; right: 6px; }

/* ── Gold text shimmer for headings ───────────────────────────────────── */
.text-grimoire {
  background: linear-gradient(135deg, #c9a84c 0%, #8b6914 40%, #c9a84c 60%, #e8d5a3 80%, #c9a84c 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: gold-shimmer 6s linear infinite;
}

/* ── Card hover effects — arcane glow ─────────────────────────────────── */
.card-hover {
  transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
}
.card-hover:hover {
  transform: scale(1.02) translateY(-2px);
  box-shadow:
    0 8px 32px -4px rgba(0, 0, 0, 0.6),
    0 0 20px rgba(180, 140, 50, 0.12),
    inset 0 1px 0 rgba(180, 140, 50, 0.08);
}

/* ── Arcane glow for important elements ───────────────────────────────── */
.arcane-glow {
  box-shadow: 0 0 12px 2px rgba(180, 140, 50, 0.15);
  transition: box-shadow 300ms ease;
}
.arcane-glow:hover {
  box-shadow: 0 0 20px 4px rgba(180, 140, 50, 0.25);
}

/* ── Glass panel — translucent grimoire page surface ──────────────────── */
