/* Landing page: scoped product presentation, using the existing grimoire palette. */
.landing-page {
  --muted-foreground: hsl(36 12% 64%);
  overflow: clip;
}
.landing-shell { width: min(100% - 3rem, 76rem); margin-inline: auto; }
.landing-section { padding-block: 4.5rem; }
.landing-eyebrow {
  margin-bottom: 0.75rem;
  color: var(--primary);
  font-family: var(--font-cinzel);
  font-size: 0.65rem;
  font-weight: 600;
  letter-spacing: 0.17em;
  text-transform: uppercase;
}
.landing-heading { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 600; line-height: 1.3; }
.landing-hero {
  background: radial-gradient(ellipse at 80% 38%, hsl(43 60% 30% / 0.13), transparent 52%);
}
.landing-product-window {
  overflow: hidden;
  border: 1px solid hsl(43 50% 40% / 0.4);
  border-radius: 0.75rem;
  background: var(--card);
  box-shadow: 0 25px 65px -20px #000, 0 0 65px -15px hsl(43 65% 35% / 0.2);
}
.landing-stats { background: linear-gradient(110deg, hsl(30 22% 10%), var(--card)); }
.landing-stats > div:nth-child(odd) { border-right: 1px solid var(--border); }
.landing-stats > div:nth-child(-n + 2) { border-bottom: 1px solid var(--border); }
.landing-text-link {
  display: inline-flex;
  align-items: center;
  gap: 0.65rem;
  color: var(--primary);
  font-size: 1rem;
  text-underline-offset: 0.25rem;
}
.landing-text-link:hover { text-decoration: underline; }
.landing-feature {
  display: block;
  padding: 1.75rem;
  border: 1px solid var(--border);
  border-radius: 0.5rem;
  background: linear-gradient(145deg, hsl(30 20% 10% / 0.8), var(--card) 65%);
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}
.landing-feature:hover, .landing-feature:focus-visible {
  transform: translateY(-4px);
  border-color: hsl(43 55% 40% / 0.55);
  box-shadow: 0 14px 30px -15px #000;
}
.landing-glyph {
  display: inline-flex;
  width: 2.75rem;
  height: 2.75rem;
  align-items: center;
  justify-content: center;
  border: 1px solid hsl(43 60% 40% / 0.45);
  border-radius: 50%;
  background: hsl(43 60% 40% / 0.07);
  color: var(--primary);
}
.landing-detail-crop {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  aspect-ratio: 850 / 860;
  border: 1px solid hsl(43 50% 40% / 0.35);
  border-radius: 0.75rem;
  background: var(--card);
}
/* Zoom the existing image to its central panels, retaining their original proportions. */
.landing-detail-image {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 50.8% 100%;
  transform: scale(1.3372);
  transform-origin: 50.8% 100%;
}
.landing-annotation, .landing-callout-number {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 50%;
  font-family: var(--font-cinzel);
  font-size: 0.75rem;
  font-weight: 700;
}
.landing-callout-number { border: 1px solid hsl(43 60% 40% / 0.45); color: var(--primary); }
.landing-annotation { position: absolute; right: 5%; background: var(--primary); color: var(--primary-foreground); box-shadow: 0 0 0 5px hsl(43 80% 48% / 0.12); }
.landing-annotation::before { content: ''; position: absolute; right: 100%; width: clamp(1.5rem, 8vw, 5rem); height: 1px; background: var(--primary); }
.landing-annotation::after { content: ''; position: absolute; right: calc(100% + clamp(1.5rem, 8vw, 5rem)); width: 5px; height: 5px; border-radius: 50%; background: var(--primary); }
.landing-point-curve { top: 13%; }
.landing-point-intelligence { top: 46%; }
.landing-point-plan { top: 76%; }
.landing-timeline { position: relative; }
.landing-timeline::before { content: ''; position: absolute; left: 1.375rem; top: 1.375rem; bottom: 1.375rem; width: 1px; background: linear-gradient(var(--primary), var(--border)); }
.landing-step { position: relative; display: flex; align-items: center; justify-content: center; width: 2.75rem; height: 2.75rem; border: 1px solid var(--primary); border-radius: 50%; background: #2b2110; color: var(--primary); font-family: var(--font-cinzel); font-weight: 700; box-shadow: 0 0 0 7px var(--background); }
@media (min-width: 768px) {
  .landing-timeline::before { top: 1.375rem; bottom: auto; left: 1.375rem; right: calc(33.333% - 0.5rem); width: auto; height: 1px; background: linear-gradient(90deg, var(--primary), var(--border)); }
}
@media (min-width: 1024px) {
  .landing-section { padding-block: 5rem; }
  .landing-product-window { transform: perspective(1500px) rotateY(-4deg) rotateZ(0.7deg); }
  .landing-stats > div:nth-child(-n + 2) { border-bottom: 0; }
  .landing-stats > div:not(:last-child) { border-right: 1px solid var(--border); }
}
@media (prefers-reduced-motion: reduce) {
  .landing-product-window, .landing-feature:hover, .landing-feature:focus-visible { transform: none; }
}
