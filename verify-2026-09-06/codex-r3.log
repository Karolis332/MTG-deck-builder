@@ -0,0 +1,57 @@
+import Image from 'next/image';
+import Link from 'next/link';
+import { ArrowRight } from 'lucide-react';
+
+// Coordinates refer to the supplied screenshot's visible curve, intelligence and
+// enablers panels. Role counts and per-card reasons are outside this capture.
+const callouts = [
+  { n: '1', title: 'Read the mana curve', body: 'See how the deck’s spells are distributed across mana values.', point: 'landing-point-curve' },
+  { n: '2', title: 'Inspect Deck Intelligence', body: 'Review the deck’s archetype and interaction & synergy score.', point: 'landing-point-intelligence' },
+  { n: '3', title: 'Understand the game plan', body: 'Trace how the deck wins through its enablers and payoffs.', point: 'landing-point-plan' },
+];
+
+export function SeeItWork() {
+  return (
+    <section aria-labelledby="see-title" className="landing-shell landing-section">
+      <div className="mb-9 flex flex-wrap items-end justify-between gap-5">
+        <div>
+          <p className="landing-eyebrow">Inside a finished build</p>
+          <h2 id="see-title" className="landing-heading">See it work</h2>
+        </div>
+        <p className="max-w-sm text-lg leading-relaxed text-muted-foreground">A decklist you can inspect, from its mana curve to its game plan.</p>
+      </div>
+      <div className="grid items-center gap-8 lg:grid-cols-[1.65fr_1fr] lg:gap-12">
+        <figure>
+          <div className="landing-detail-crop">
+            <Image
+              src="/screenshots/builder-result.png"
+              width={1513}
+              height={1150}
+              sizes="(max-width: 1023px) 170vw, 1200px"
+              alt="Detail of the Krenko deck result: mana curve, Deck Intelligence score, and enabler and payoff cards under How This Deck Wins"
+              className="landing-detail-image"
+            />
+            {callouts.map((callout) => (
+              <span key={callout.n} aria-hidden="true" className={`landing-annotation ${callout.point}`}>{callout.n}</span>
+            ))}
+          </div>
+          <figcaption className="mt-3 text-sm text-muted-foreground">Krenko, Mob Boss · Detail from the builder result</figcaption>
+        </figure>
+        <div>
+          <ol className="divide-y divide-border">
+            {callouts.map((callout) => (
+              <li key={callout.n} className="flex gap-4 py-6 first:pt-0">
+                <span className="landing-callout-number">{callout.n}</span>
+                <div>
+                  <h3 className="mb-2 text-base font-semibold">{callout.title}</h3>
+                  <p className="text-base leading-relaxed text-muted-foreground">{callout.body}</p>
+                </div>
+              </li>
+            ))}
+          </ol>
+          <Link href="/builder" className="landing-text-link mt-4">Build your own deck <ArrowRight aria-hidden="true" className="size-4" /></Link>
+        </div>
+      </div>
+    </section>
+  );
+}
