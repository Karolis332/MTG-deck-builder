+export function FaqPreview() {
+  return (
+    <section aria-labelledby="faq-title" className="landing-shell landing-section border-t border-border">
+      <div className="grid gap-8 md:grid-cols-[1fr_1.5fr] md:gap-16">
+        <div>
+          <p className="landing-eyebrow">Before you build</p>
+          <h2 id="faq-title" className="landing-heading">Common questions</h2>
+          <Link href="/faq" className="landing-text-link mt-5">See all questions <ArrowUpRight aria-hidden="true" className="size-4" /></Link>
+        </div>
+        <div className="divide-y divide-border border-y border-border">
+          {questions.map((question) => (
+            <Link key={question} href="/faq" className="flex items-center justify-between gap-5 px-2 py-5 text-lg transition-colors hover:bg-accent hover:text-primary">
+              {question}<ArrowUpRight aria-hidden="true" className="size-4 shrink-0 text-primary" />
+            </Link>
+          ))}
+        </div>
+      </div>
+      <p className="mt-12 flex items-start justify-center gap-3 text-sm text-muted-foreground">
+        <MessageSquareText aria-hidden="true" className="mt-0.5 size-4 shrink-0 text-primary" />
+        <span>Found a wrong suggestion or missing card? Use the feedback button on any page, or the{' '}
+          <Link href="/contact" className="text-primary hover:underline">contact form</Link>.
+        </span>
+      </p>
+    </section>
+  );
+}
