+import { Database, Layers3, RefreshCw, UnlockKeyhole } from 'lucide-react';
+import { siteFacts } from '@/lib/site-facts';
+
+const stats = [
+  { icon: Database, value: siteFacts.deckCount.toLocaleString('en-US'), label: 'decks in the corpus' },
+  { icon: Layers3, value: siteFacts.formats.length, label: 'supported formats' },
+  { icon: RefreshCw, value: `${siteFacts.banditRetrainHours}h`, label: 'model retrain cadence' },
+  { icon: UnlockKeyhole, value: 'Free', label: 'price for every player' },
+];
+
+export function StatStrip() {
+  return (
+    <section aria-labelledby="stats-title" className="landing-shell">
+      <h2 id="stats-title" className="sr-only">The Black Grimoire in numbers</h2>
+      <dl className="landing-stats grid grid-cols-2 overflow-hidden rounded-lg border border-primary/20 lg:grid-cols-4">
+        {stats.map((stat) => (
+          <div key={stat.label} className="flex flex-col px-5 py-6 sm:px-7">
+            <dt className="order-2 mt-2 text-sm text-muted-foreground">{stat.label}</dt>
+            <dd className="flex flex-wrap items-center gap-3">
+              <stat.icon aria-hidden="true" className="size-4 shrink-0 text-primary/80" strokeWidth={1.5} />
+              <span className="font-heading text-xl font-semibold tracking-wide text-foreground sm:text-2xl">{stat.value}</span>
+            </dd>
+          </div>
+        ))}
+      </dl>
+      <p className="mt-3 text-right text-xs text-muted-foreground">
+        Public decklists from {siteFacts.sources.join(', ')} · As of <time dateTime={siteFacts.asOf}>{siteFacts.asOf}</time>
+      </p>
+    </section>
+  );
+}
