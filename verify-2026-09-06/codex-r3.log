+          </p>
+        </div>
+        <figure className="landing-product-window min-w-0">
+          <div className="flex items-center gap-3 border-b border-primary/20 px-4 py-3 text-xs text-muted-foreground">
+            <span aria-hidden="true" className="flex gap-1.5">
+              <span className="size-1.5 rounded-full bg-primary/70" />
+              <span className="size-1.5 rounded-full bg-primary/35" />
+              <span className="size-1.5 rounded-full bg-primary/20" />
