+import Link from 'next/link';
+import { ArrowRight } from 'lucide-react';
+
+const colours = [
+  { pip: 'W', name: 'White', fill: 'var(--color-mana-white)', ink: '#150B00' },
+  { pip: 'U', name: 'Blue', fill: 'var(--color-mana-blue)', ink: '#F9FAF4' },
+  { pip: 'B', name: 'Black', fill: 'var(--color-mana-black)', ink: '#F9FAF4' },
+  { pip: 'R', name: 'Red', fill: 'var(--color-mana-red)', ink: '#F9FAF4' },
+  { pip: 'G', name: 'Green', fill: 'var(--color-mana-green)', ink: '#F9FAF4' },
+];
+
+export function ColourIdentity() {
+  return (
+    <section aria-labelledby="identity-title" className="landing-shell pb-16">
+      <div className="flex flex-col items-center justify-between gap-6 rounded-lg border border-border bg-card px-6 py-8 text-center md:flex-row md:text-left">
+        <div className="flex shrink-0 gap-3" aria-label="White, blue, black, red and green">
+          {colours.map((colour) => (
+            <svg key={colour.pip} viewBox="0 0 40 40" width="40" height="40" role="img" aria-label={`${colour.name} mana`}>
+              <circle cx="20" cy="20" r="18" fill={colour.fill} stroke="#CBAC5D" strokeOpacity="0.45" />
