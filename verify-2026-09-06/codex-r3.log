+import { Heart } from 'lucide-react';
+import { DonateCta } from '@/components/support-section';
+import { supporters } from '@/lib/supporters';
+
+const tiers = [
+  { tier: 'patron', title: 'Patrons' },
+  { tier: 'supporter', title: 'Supporters' },
+] as const;
+
+const monthFormatter = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
+
+function joinedMonth(since: string) {
+  const date = new Date(`${since.slice(0, 7)}-01T00:00:00Z`);
+  return Number.isNaN(date.getTime()) ? since : monthFormatter.format(date);
+}
+
+export function SupportersSection() {
+  return (
+    <section aria-labelledby="supporters-title" className="space-y-6">
+      <div>
+        <div className="mb-4 flex items-center gap-2 text-primary">
+          <Heart aria-hidden="true" className="size-4" strokeWidth={1.5} />
+          <span className="font-heading text-xs tracking-widest">Made possible by players</span>
+        </div>
+        <h2 id="supporters-title" className="mb-2 text-2xl font-bold text-grimoire">Our supporters</h2>
+        <p className="text-muted-foreground leading-relaxed">The people helping keep The Black Grimoire free.</p>
+      </div>
+      {supporters.length === 0 ? (
+        <div className="rounded-lg border border-dashed border-primary/25 bg-card/60 px-6 py-8">
+          <p className="mb-5 text-lg">No supporters yet. Be the first.</p>
+          <DonateCta />
+        </div>
+      ) : (
+        <>
+          {tiers.map(({ tier, title }) => {
+            const members = supporters.filter((supporter) => supporter.tier === tier);
+            if (members.length === 0) return null;
+            return (
+              <div key={tier}>
+                <h3 className="mb-3 text-sm font-semibold text-primary">{title}</h3>
+                <ul className="grid gap-3 sm:grid-cols-2">
+                  {members.map((member) => (
+                    <li key={`${member.name}-${member.since}`} className="rounded-lg border border-border bg-card px-4 py-3">
+                      <p className="break-words text-lg">{member.name}</p>
+                      <p className="text-sm text-muted-foreground">Joined <time dateTime={member.since}>{joinedMonth(member.since)}</time></p>
+                    </li>
+                  ))}
+                </ul>
+              </div>
+            );
+          })}
+          <DonateCta />
+        </>
+      )}
+    </section>
+  );
+}
