+import Image from 'next/image';
+import Link from 'next/link';
+import { ArrowRight, Sparkles } from 'lucide-react';
+import { buttonVariants } from '@/components/ui/button';
+import { siteFacts } from '@/lib/site-facts';
+import { cn } from '@/lib/utils';
+
+export function Hero() {
+  return (
+    <section aria-labelledby="hero-title" className="landing-hero">
+      <div className="landing-shell grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[0.95fr_1.15fr] lg:gap-12 lg:py-20">
+        <div>
+          <p className="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/25 bg-primary/5 px-3 py-1.5 text-sm text-primary">
+            <Sparkles aria-hidden="true" className="size-3.5" />
+            Free · No account required
+          </p>
+          <h1 id="hero-title" className="text-[1.65rem] font-semibold leading-[1.45] tracking-normal sm:text-[2rem] lg:text-[2.05rem]">
+            The Black Grimoire is a <span className="text-primary">free Commander and Brawl deck builder</span>{' '}
+            that ranks cards using patterns from {siteFacts.deckCountPretty} real decklists.
+          </h1>
+          <p className="mt-5 max-w-lg text-lg leading-relaxed text-muted-foreground">
+            The engine provides a complete 99-card deck for any legal commander, with a
+            stated reason attached to every card and a check against Wizards&apos; official
+            Commander Bracket rules. There is no paywall, no required account, and no
+            filler card added just to pad the count.
+          </p>
+          <div className="mt-7 flex flex-col gap-3 sm:flex-row">
+            <Link href="/builder" className={cn(buttonVariants({ size: 'lg' }), 'gap-2')}>
+              Build a deck free <ArrowRight aria-hidden="true" className="size-4" />
+            </Link>
+            <Link href="/commanders" className={buttonVariants({ variant: 'outline', size: 'lg' })}>
+              Browse commanders
+            </Link>
+          </div>
+          <p className="mt-4 text-sm text-muted-foreground">
+            Works in your browser · Builds take {siteFacts.buildTimeLow}–{siteFacts.buildTimeHigh}s
+          </p>
+        </div>
+        <figure className="landing-product-window min-w-0">
+          <div className="flex items-center gap-3 border-b border-primary/20 px-4 py-3 text-xs text-muted-foreground">
+            <span aria-hidden="true" className="flex gap-1.5">
+              <span className="size-1.5 rounded-full bg-primary/70" />
+              <span className="size-1.5 rounded-full bg-primary/35" />
+              <span className="size-1.5 rounded-full bg-primary/20" />
+            </span>
+            <span className="font-mono text-[10px] tracking-wider">THE BLACK GRIMOIRE / BUILDER</span>
+          </div>
+          <Image
+            src="/screenshots/builder-result.png"
+            width={1513}
+            height={1150}
+            priority
+            sizes="(max-width: 1023px) calc(100vw - 48px), (max-width: 1279px) 52vw, 650px"
+            alt="A Krenko, Mob Boss deck built by The Black Grimoire: 100 cards, 38 lands, mana curve and deck intelligence"
+            className="block h-auto w-full"
+          />
+          <figcaption className="flex items-center justify-between gap-3 border-t border-primary/15 px-4 py-3 text-sm">
+            <span>Krenko, Mob Boss <span className="text-muted-foreground">/ Commander</span></span>
+            <span className="text-primary">Builder result</span>
+          </figcaption>
+        </figure>
+      </div>
+    </section>
+  );
+}
diff --git a/src/components/landing/see-it-work.tsx b/src/components/landing/see-it-work.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..704ddce74ec856945309d1b776da3152e465fa8d
--- /dev/null
+++ b/src/components/landing/see-it-work.tsx
@@ -0,0 +1,57 @@
+import Image from 'next/image';
+import Link from 'next/link';
+import { ArrowRight } from 'lucide-react';
+
+// Coordinates refer to the supplied screenshot's visible curve, intelligence and
+// enablers panels. Role counts and per-card reasons are outside this capture.
+const callouts = [
+  { n: '1', title: 'Read the mana curve', body: 'See how the deck’s spells are distributed across mana values.', point: 'landing-point-curve' },
+  { n: '2', title: 'Inspect Deck Intelligence', body: 'Review the deck’s archetype and interaction & synergy score.', point: 'landing-point-intelligence' },
+  { n: '3', title: 'Understand the game plan', body: 'Trace how the deck wins through its enablers and payoffs.', point: 'landing-point-plan' },
+];
+
+export function SeeItWork() {
+  return (
+    <section aria-labelledby="see-title" className="landing-shell landing-section">
+      <div className="mb-9 flex flex-wrap items-end justify-between gap-5">
+        <div>
+          <p className="landing-eyebrow">Inside a finished build</p>
+          <h2 id="see-title" className="landing-heading">See it work</h2>
+        </div>
+        <p className="max-w-sm text-lg leading-relaxed text-muted-foreground">A decklist you can inspect, from its mana curve to its game plan.</p>
+      </div>
+      <div className="grid items-center gap-8 lg:grid-cols-[1.65fr_1fr] lg:gap-12">
+        <figure>
+          <div className="landing-detail-crop">
+            <Image
+              src="/screenshots/builder-result.png"
+              width={1513}
+              height={1150}
+              sizes="(max-width: 1023px) 170vw, 1200px"
+              alt="Detail of the Krenko deck result: mana curve, Deck Intelligence score, and enabler and payoff cards under How This Deck Wins"
+              className="landing-detail-image"
+            />
+            {callouts.map((callout) => (
+              <span key={callout.n} aria-hidden="true" className={`landing-annotation ${callout.point}`}>{callout.n}</span>
+            ))}
+          </div>
+          <figcaption className="mt-3 text-sm text-muted-foreground">Krenko, Mob Boss · Detail from the builder result</figcaption>
+        </figure>
+        <div>
+          <ol className="divide-y divide-border">
+            {callouts.map((callout) => (
+              <li key={callout.n} className="flex gap-4 py-6 first:pt-0">
+                <span className="landing-callout-number">{callout.n}</span>
+                <div>
+                  <h3 className="mb-2 text-base font-semibold">{callout.title}</h3>
+                  <p className="text-base leading-relaxed text-muted-foreground">{callout.body}</p>
+                </div>
+              </li>
+            ))}
+          </ol>
+          <Link href="/builder" className="landing-text-link mt-4">Build your own deck <ArrowRight aria-hidden="true" className="size-4" /></Link>
+        </div>
+      </div>
+    </section>
+  );
+}
